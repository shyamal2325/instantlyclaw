# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GETRESPONSE_API_KEY: Secret GetResponse API key for server-side subscriber sync
GETRESPONSE_API_KEY="MY_GETRESPONSE_API_KEY"

# GETRESPONSE_CAMPAIGN_ID: Target GetResponse contact list token / campaign ID
GETRESPONSE_CAMPAIGN_ID="MY_GETRESPONSE_CAMPAIGN_ID"

# VITE_AFFILIATE_URL: Destination affiliate link
VITE_AFFILIATE_URL="https://jvz1.com/c/3334211/436489/"

# VITE_META_PIXEL_ID: Optional Meta Pixel ID for Facebook/Instagram ads conversion tracking
VITE_META_PIXEL_ID=""
